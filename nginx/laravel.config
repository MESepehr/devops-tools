server {
    listen 80;
    listen [::]:80;
    
    server_name api.hamup.ir;
    
    # Maximum upload size (adjust as needed)
    client_max_body_size 100M;
    
    # Logging (optional but recommended)
    access_log /var/log/nginx/api.hamup.ir_access.log;
    error_log /var/log/nginx/api.hamup.ir_error.log;
    
    # Root location - API proxy to localhost:8000
    location / {
        proxy_pass http://localhost:8000;
        proxy_http_version 1.1;
        
        # Headers for proper proxy behavior
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffering settings
        proxy_buffering off;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }
    
    # File server location for /hamupfiles directory
    location /files/ {
        alias /home/devops/hamupfiles/;
        
        # Enable directory listing (optional - remove if not needed)
        autoindex off;
        
        # Security headers for file downloads
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        
        # Cache static files for 1 hour
        expires 1h;
        add_header Cache-Control "public, immutable";
        
        # Try to serve file, return 404 if not found
        try_files $uri =404;
        
        # Prevent access to hidden files
        location ~ /\. {
            deny all;
            return 404;
        }
        
        # Prevent access to sensitive files
        location ~* (?:\.(?:bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)|~)$ {
            deny all;
            return 404;
        }
    }
    
    # Optional: Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}